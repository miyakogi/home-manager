#!/usr/bin/env bash

set -euo pipefail

usage() {
  echo "usage: niri-workspace {focus|move {next|prev|last|first|<n>}|toggle <name>}" >&2
}

# Workspace names to exclude from focus/move, comma-separated in NIRI_SCRATCHPAD_NAMES.
names_json=$(jq -Rn --arg e "${NIRI_SCRATCHPAD_NAMES:-}" \
  '$e | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0))')

action="${1:-}"

case "$action" in
  focus|move)
    if [[ ! "${2:-}" =~ ^([0-9]{1,18}|next|prev|last|first)$ ]]; then
      usage
      exit 1
    fi
    ;;
  toggle)
    if [[ -n "${2:-}" && ! "${2:-}" =~ ^[a-zA-Z0-9_-]+$ ]]; then
      echo "invalid workspace name: ${2:-}" >&2
      exit 1
    fi
    ;;
  *)
    usage
    exit 1
    ;;
esac

runtime_dir="${XDG_RUNTIME_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}}/niri-workspace"
mkdir -p -m 700 "$runtime_dir"

workspaces=$(niri msg --json workspaces)
output=$(niri msg --json focused-output | jq -r '.name')

eligible_idx() {
  jq -c --arg output "$output" --argjson names "$names_json" '
    [ .[] | select(.output == $output)
    | select((.name // "") as $n | $names | index($n) | not)
    | .idx ]
    | sort
  ' <<< "$workspaces"
}

focused_idx() {
  jq -r '.[] | select(.is_focused == true) | .idx' <<< "$workspaces"
}

cycle_target() {
  local direction="$1" current candidates target
  current=$(focused_idx)
  candidates=$(eligible_idx)
  target=$(jq -r --argjson c "$current" --arg dir "$direction" '
    if $dir == "next"
      then ([ .[] | select(. > $c) ] | min // empty)
      else ([ .[] | select(. < $c) ] | max // empty)
    end
  ' <<< "$candidates")
  if [[ -z "$target" ]]; then
    target=$(jq -r --arg dir "$direction" '
      if $dir == "next" then min // empty else max // empty end
    ' <<< "$candidates")
  fi
  printf '%s\n' "$target"
}

extreme_target() {
  jq -r --arg mode "$1" '
    if $mode == "first" then min // empty else max // empty end
  ' <<< "$(eligible_idx)"
}

workspace_action() {
  local mode="$1" direction="$2" target
  case "$direction" in
    next|prev) target=$(cycle_target "$direction") ;;
    last)      target=$(extreme_target last) ;;
    first)     target=$(extreme_target first) ;;
    *)         # numeric N (1-based; 0 = no-op; N > count = clamp to last)
      if (( 10#$direction == 0 )); then
        return 0
      fi
      target=$(jq -r --argjson n "$((10#$direction - 1))" '
        if $n >= length then .[-1] // empty else .[$n] // empty end
      ' <<< "$(eligible_idx)")
      ;;
  esac
  if [[ -n "$target" ]]; then
    if [[ "$mode" == "focus" ]]; then
      niri msg action focus-workspace "$target"
    else
      niri msg action move-window-to-workspace "$target"
    fi
  fi
}

restore_scratchpad() {
  local state_file="$1" prev_output entry output_name idx
  prev_output=$(jq -r '.output' "$state_file")
  mapfile -t entries < <(jq -c '.workspaces[]' "$state_file")
  for entry in "${entries[@]}"; do
    output_name=$(jq -r '.output' <<< "$entry")
    idx=$(jq -r '.idx' <<< "$entry")
    if jq -e --arg o "$output_name" --argjson i "$idx" '
      any(.[]; .output == $o and .is_active == true and .idx != $i)
      and any(.[]; .idx == $i)
    ' <<< "$workspaces" >/dev/null; then
      niri msg action focus-monitor "$output_name" || true
      niri msg action focus-workspace "$idx" || true
    fi
  done
  if [[ -n "$prev_output" ]] && jq -e --arg o "$prev_output" \
      'any(.[]; .output == $o)' <<< "$workspaces" >/dev/null; then
    niri msg action focus-monitor "$prev_output" || true
  fi
}

toggle_scratchpad() {
  local name="$1" state_file visible
  state_file="${runtime_dir}/niri-${name}.json"
  visible=$(jq -r --arg name "$name" '
    any(.[]; .name == $name and .is_active == true)
  ' <<< "$workspaces")
  if [[ "$visible" == "true" ]]; then
    if [[ -s "$state_file" ]]; then
      restore_scratchpad "$state_file"
      rm -f "$state_file"
    fi
    exit 0
  fi
  jq -c --arg output "$output" --arg name "$name" '
    {
      output: $output,
      workspaces: [ .[] | select(.is_active == true)
      | select((.name // "") != $name)
      | {output, idx} ]
    }
  ' <<< "$workspaces" > "${state_file}.tmp"
  mv "${state_file}.tmp" "$state_file"
  niri msg action focus-workspace "$name"
}

case "$action" in
  focus|move) workspace_action "$action" "${2:-}" ;;
  toggle)     toggle_scratchpad "${2:-main}" ;;
esac
