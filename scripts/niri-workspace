#!/usr/bin/env bash

set -euo pipefail

# Workspace names to exclude, comma-separated in NIRI_SCRATCHPAD_NAMES.
# Unset or empty = no exclusions.
scratchpad_names=()
if [[ -n "${NIRI_SCRATCHPAD_NAMES:-}" ]]; then
  IFS=',' read -ra parsed <<< "$NIRI_SCRATCHPAD_NAMES"
  for name in "${parsed[@]}"; do
    name="${name#"${name%%[![:space:]]*}"}"   # trim leading whitespace
    name="${name%"${name##*[![:space:]]}"}"   # trim trailing whitespace
    if [[ -n "$name" ]]; then
      scratchpad_names+=("$name")
    fi
  done
fi

monitor1="DP-1"
monitor2="HDMI-A-2"

if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
  runtime_dir="$XDG_RUNTIME_DIR"
else
  runtime_dir="${XDG_STATE_HOME:-$HOME/.local/state}/niri-workspace"
  mkdir -p -m 700 "$runtime_dir"
fi

action="${1:-}"

workspaces=$(niri msg --json workspaces)
output=$(niri msg --json focused-output | jq -r '.name')

names_json=$(printf '%s\n' "${scratchpad_names[@]}" | jq -Rs 'split("\n") | map(select(length > 0))')

eligible_idx() {
  jq -c --arg output "$output" --argjson names "$names_json" '
    [ .[] | select(.output == $output)
    | select((.name // "") as $n | $names | index($n) | not)
    | .idx ]
    | sort
  ' <<< "$workspaces"
}

focused_idx() {
  jq -r '.[] | select(.is_focused == true) | .idx' <<< "$workspaces"
}

cycle_target() {
  local direction="$1" current candidates target
  current=$(focused_idx)
  candidates=$(eligible_idx)
  target=$(jq -r --argjson c "$current" --arg dir "$direction" '
    if $dir == "next"
      then ([ .[] | select(. > $c) ] | min // empty)
      else ([ .[] | select(. < $c) ] | max // empty)
    end
  ' <<< "$candidates")
  if [[ -z "$target" ]]; then
    target=$(jq -r --arg dir "$direction" '
      if $dir == "next" then min // empty else max // empty end
    ' <<< "$candidates")
  fi
  printf '%s\n' "$target"
}

extreme_target() {
  jq -r --arg mode "$1" '
    if $mode == "first" then min // empty else max // empty end
  ' <<< "$(eligible_idx)"
}

workspace_action() {
  local mode="$1" direction="$2" target
  case "$direction" in
    next|prev) target=$(cycle_target "$direction") ;;
    last)      target=$(extreme_target last) ;;
    first)     target=$(extreme_target first) ;;
    *)         # numeric N (1-based; 0 = no-op; N > count = clamp to last)
      if (( 10#$direction == 0 )); then
        return 0
      fi
      target=$(jq -r --argjson n "$((10#$direction - 1))" '
        if $n >= length then .[-1] // empty else .[$n] // empty end
      ' <<< "$(eligible_idx)")
      ;;
  esac
  if [[ -n "$target" ]]; then
    if [[ "$mode" == "focus" ]]; then
      niri msg action focus-workspace "$target"
    else
      niri msg action move-window-to-workspace "$target"
    fi
  fi
}

output_exists() {
  jq -e --arg o "$1" 'any(.[]; .output == $o)' <<< "$workspaces" >/dev/null
}

toggle_scratchpad() {
  local name="$1"
  if [[ ! "$name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "invalid workspace name: $name" >&2
    exit 1
  fi
  local state_file1="${runtime_dir}/niri-$name-workspace-output1"
  local state_file2="${runtime_dir}/niri-$name-workspace-output2"
  local output_file="${runtime_dir}/niri-$name-output"

  local visible
  visible=$(jq -r --arg name "$name" '
    any(.[]; .name == $name and .is_active == true)
  ' <<< "$workspaces")

  if [[ "$visible" == "true" && ( -s "$state_file1" || -s "$state_file2" || -s "$output_file" ) ]]; then
    local previous_idx1 previous_idx2 previous_output
    if [[ -s "$state_file1" ]]; then
      previous_idx1=$(<"$state_file1")
      rm -f "$state_file1"
      if [[ "$previous_idx1" =~ ^[0-9]+$ ]] && output_exists "$monitor1"; then
        niri msg action focus-monitor "$monitor1" || true
        niri msg action focus-workspace "$previous_idx1" || true
      fi
    fi
    if [[ -s "$state_file2" ]]; then
      previous_idx2=$(<"$state_file2")
      rm -f "$state_file2"
      if [[ "$previous_idx2" =~ ^[0-9]+$ ]] && output_exists "$monitor2"; then
        niri msg action focus-monitor "$monitor2" || true
        niri msg action focus-workspace "$previous_idx2" || true
      fi
    fi
    if [[ -s "$output_file" ]]; then
      previous_output=$(<"$output_file")
      rm -f "$output_file"
      if [[ -n "$previous_output" ]] && output_exists "$previous_output"; then
        niri msg action focus-monitor "$previous_output" || true
      fi
    fi
    exit 0
  fi

  local idx1 idx2
  idx1=$(jq -r --arg output "$monitor1" '
    .[]
    | select(.output == $output)
    | select(.is_active == true)
    | .idx
  ' <<< "$workspaces")

  idx2=$(jq -r --arg output "$monitor2" '
    .[]
    | select(.output == $output)
    | select(.is_active == true)
    | .idx
  ' <<< "$workspaces")

  printf '%s\n' "$output" > "$output_file"
  printf '%s\n' "$idx1" > "$state_file1"
  printf '%s\n' "$idx2" > "$state_file2"
  niri msg action focus-workspace "$name"
}

case "$action" in
  focus)
    if [[ "${2:-}" =~ ^[0-9]{1,18}$ ]] || [[ "${2:-}" =~ ^(next|prev|last|first)$ ]]; then
      workspace_action focus "$2"
    else
      echo "usage: niri-workspace focus {next|prev|last|first|<n>}" >&2
      exit 1
    fi
    ;;
  move)
    if [[ "${2:-}" =~ ^[0-9]{1,18}$ ]] || [[ "${2:-}" =~ ^(next|prev|last|first)$ ]]; then
      workspace_action move "$2"
    else
      echo "usage: niri-workspace move {next|prev|last|first|<n>}" >&2
      exit 1
    fi
    ;;
  toggle)
    toggle_scratchpad "${2:-main}"
    ;;
  *)
    echo "usage: niri-workspace {focus|move {next|prev|last|first|<n>}|toggle <name>}" >&2
    exit 1
    ;;
esac
