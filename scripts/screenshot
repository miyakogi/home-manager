#!/usr/bin/env bash
set -euo pipefail

grim_file="${XDG_PICTURES_DIR:-$HOME/Pictures}/screenshots/grim/grim-$(date +%Y%m%d-%H%M%S).jpg"
notify_file="${grim_file/#$HOME/~}"
mkdir -p "$(dirname "$grim_file")"

case "${1:-}" in
  fullscreen)
    grim -t jpeg "$grim_file"
    notify-send -i camera "Screenshot saved to $notify_file"
    ;;
  window)
    # Only Hyprland calls this path; Niri binds Shift+Print to its own
    # screenshot-window action (see niri/config.kdl).
    case "$XDG_CURRENT_DESKTOP" in
      Hyprland)
        # `activewindow` is `{}` when no window is focused; skip in that case.
        geom=$(hyprctl -j activewindow | jq -r 'if .at and .size then "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])" else empty end')
        if [ "$geom" != "" ]; then
          grim -g "$geom" -t jpeg "$grim_file"
          notify-send -i camera "Screenshot saved to $notify_file"
        fi
        ;;
      sway*)
        grim -g "$(swaymsg -t get_tree | jq -r '.. | select(.focused?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"')" -t jpeg "$grim_file"
        notify-send -i camera "Screenshot saved to $notify_file"
        ;;
    esac
    ;;
  region)
    grim -g "$(slurp)" - | swappy -f -
    ;;
esac
