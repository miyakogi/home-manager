#!/usr/bin/env bash

set -euo pipefail

# Workspace names to exclude. Add, remove, or modify them here.
scratchpad_names=(
  "memo"
  "ai"
)

monitor1="DP-1"
monitor2="HDMI-A-2"

runtime_dir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"

action="${1:-}"

workspaces=$(niri msg --json workspaces)
output=$(niri msg --json focused-output | jq -r '.name')

names_json=$(printf '%s\n' "${scratchpad_names[@]}" | jq -Rs 'split("\n") | map(select(length > 0))')

eligible_idx() {
  jq -c --arg output "$output" --argjson names "$names_json" '
    [ .[] | select(.output == $output)
    | select((.name // "") as $n | $names | index($n) | not)
    | .idx ]
    | sort
  ' <<< "$workspaces"
}

focused_idx() {
  jq -r '.[] | select(.is_focused == true) | .idx' <<< "$workspaces"
}

focused_id() {
  jq -r '.[] | select(.is_focused == true) | .id' <<< "$workspaces"
}

cycle_target() {
  local direction="$1" current candidates target
  current=$(focused_idx)
  candidates=$(eligible_idx)
  target=$(jq -r --argjson c "$current" --arg dir "$direction" '
    if $dir == "next"
      then ([ .[] | select(. > $c) ] | min // empty)
      else ([ .[] | select(. < $c) ] | max // empty)
    end
  ' <<< "$candidates")
  if [[ -z "$target" ]]; then
    target=$(jq -r --arg dir "$direction" '
      if $dir == "next" then min // empty else max // empty end
    ' <<< "$candidates")
  fi
  printf '%s\n' "$target"
}

extreme_target() {
  jq -r --arg mode "$1" '
    if $mode == "first" then min // empty else max // empty end
  ' <<< "$(eligible_idx)"
}

workspace_action() {
  local mode="$1" direction="$2" target
  case "$direction" in
    next|prev) target=$(cycle_target "$direction") ;;
    last)      target=$(extreme_target last) ;;
    first)     target=$(extreme_target first) ;;
    *)         # numeric N (1-based; 0 = no-op; N > count = clamp to last)
      if [[ "$direction" == "0" ]]; then
        return 0
      fi
      target=$(jq -r --argjson n "$((direction - 1))" '
        if $n >= length then .[-1] // empty else .[$n] // empty end
      ' <<< "$(eligible_idx)")
      ;;
  esac
  if [[ -n "$target" ]]; then
    if [[ "$mode" == "focus" ]]; then
      niri msg action focus-workspace "$target"
    else
      niri msg action move-window-to-workspace "$target"
    fi
  fi
}

toggle_scratchpad() {
  local name="$1"
  if [[ ! "$name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "invalid workspace name: $name" >&2
    exit 1
  fi
  local state_file1="${runtime_dir}/niri-$name-workspace-output1"
  local state_file2="${runtime_dir}/niri-$name-workspace-output2"
  local output_file="${runtime_dir}/niri-$name-output"

  local scratchpad_id current_id
  scratchpad_id=$(jq -r --arg name "$name" '
    .[]
    | select(.name == $name)
    | .id
  ' <<< "$workspaces")
  current_id=$(focused_id)

  if [[ "$current_id" == "$scratchpad_id" ]]; then
    if [[ -s "$state_file1" ]]; then
      previous_idx1=$(<"$state_file1")
      rm -f "$state_file1"
      niri msg action focus-monitor "$monitor1"
      niri msg action focus-workspace "$previous_idx1"
    fi
    if [[ -s "$state_file2" ]]; then
      previous_idx2=$(<"$state_file2")
      rm -f "$state_file2"
      niri msg action focus-monitor "$monitor2"
      niri msg action focus-workspace "$previous_idx2"
    fi
    if [[ -s "$output_file" ]]; then
      previous_output=$(<"$output_file")
      rm -f "$output_file"
      niri msg action focus-monitor "$previous_output"
    fi
    exit 0
  fi

  local idx1 idx2
  idx1=$(jq -r --arg output "$monitor1" '
    .[]
    | select(.output == $output)
    | select(.is_active == true)
    | .idx
  ' <<< "$workspaces")

  idx2=$(jq -r --arg output "$monitor2" '
    .[]
    | select(.output == $output)
    | select(.is_active == true)
    | .idx
  ' <<< "$workspaces")

  printf '%s\n' "$output" > "$output_file"
  printf '%s\n' "$idx1" > "$state_file1"
  printf '%s\n' "$idx2" > "$state_file2"
  niri msg action focus-workspace "$name"
}

case "$action" in
  focus)
    if [[ "${2:-}" =~ ^[0-9]+$ ]] || [[ "${2:-}" =~ ^(next|prev|last|first)$ ]]; then
      workspace_action focus "$2"
    else
      echo "usage: niri-workspace focus {next|prev|last|first|<n>}" >&2
      exit 1
    fi
    ;;
  move)
    if [[ "${2:-}" =~ ^[0-9]+$ ]] || [[ "${2:-}" =~ ^(next|prev|last|first)$ ]]; then
      workspace_action move "$2"
    else
      echo "usage: niri-workspace move {next|prev|last|first|<n>}" >&2
      exit 1
    fi
    ;;
  toggle)
    toggle_scratchpad "${2:-main}"
    ;;
  *)
    echo "usage: niri-workspace {focus|move {next|prev|last|first|<n>}|toggle <name>}" >&2
    exit 1
    ;;
esac
